package fix

import (
	"github.com/bronystylecrazy/di"
	"github.com/bronystylecrazy/ultrastack/stack"
)

type Config struct{}
type DB struct{}

func NewConfig() *Config    { return &Config{} }
func NewDB(cfg *Config) *DB { return &DB{} }

func assemble() {
	stack.Run(
		di.Provide(NewConfig),
		di.Provide(NewDB), // want `error\[DI0001\]: no provider for \*fix.Config \(needed by NewDB\)`
	)
}

// The one-line assembly: the same fix lands inline, not on a new line.
func inline() {
	stack.Run(di.Provide(NewConfig), di.Provide(NewDB)) // want `error\[DI0001\]: no provider for \*fix.Config \(needed by NewDB\)`
}
